# -------------------------------------------------------------
# SAMRIDH-AI Platform Configuration
# -------------------------------------------------------------
PROJECT_NAME="SAMRIDH-AI"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true
DEMO_MODE=true

# Security & JWT
SECRET_KEY="samridh_super_secret_jwt_signing_key_change_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL + PostGIS in prod, SQLite for zero-dep dev)
DATABASE_URL="sqlite:///./samridh_ai.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samridh_ai"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","*"]

# Image Quality & Fraud Thresholds
IMAGE_BLUR_THRESHOLD=100.0
IMAGE_MIN_LUMINANCE=40.0
IMAGE_MAX_LUMINANCE=240.0
PHASH_HAMMING_DISTANCE_THRESHOLD=10
SIFT_FEATURE_MATCH_THRESHOLD=0.65
GPS_MAX_ALLOWED_DISTANCE_METERS=150.0

# Integration Mock Flags
MOCK_PMFBY_PROVIDER=true
MOCK_WEATHER_PROVIDER=true
MOCK_SATELLITE_PROVIDER=true
MOCK_OTP_PROVIDER=true
MOCK_OTP_CODE="123456"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
